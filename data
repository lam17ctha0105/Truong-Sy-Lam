PRAGMA foreign_keys = ON;
BEGIN;

CREATE TABLE users (
  id INTEGER PRIMARY KEY,
  full_name TEXT NOT NULL,
  email TEXT NOT NULL COLLATE NOCASE UNIQUE,
  phone TEXT NOT NULL,
  password_hash TEXT NOT NULL,
  role TEXT NOT NULL CHECK (role IN ('tenant', 'owner', 'admin'))
);

CREATE TABLE districts (
  name TEXT PRIMARY KEY NOT NULL,
  city TEXT NOT NULL DEFAULT 'Cần Thơ'
);

CREATE TABLE wards (
  district TEXT NOT NULL REFERENCES districts(name),
  name TEXT NOT NULL,
  PRIMARY KEY (district, name)
);

CREATE TABLE rooms (
  id TEXT PRIMARY KEY NOT NULL,
  owner_id INTEGER REFERENCES users(id),
  title TEXT NOT NULL,
  type TEXT NOT NULL CHECK (type IN ('Phòng trọ', 'Studio', 'Căn hộ mini', 'Ở ghép')),
  district TEXT NOT NULL,
  ward TEXT NOT NULL,
  street TEXT,
  address TEXT,
  size_m2 REAL NOT NULL CHECK (size_m2 > 0),
  max_occupants INTEGER NOT NULL CHECK (max_occupants > 0),
  price_vnd INTEGER NOT NULL CHECK (price_vnd > 0),
  deposit_vnd INTEGER CHECK (deposit_vnd >= 0),
  electricity_vnd INTEGER CHECK (electricity_vnd >= 0),
  water_vnd INTEGER CHECK (water_vnd >= 0),
  available_from TEXT,
  availability TEXT NOT NULL DEFAULT 'Còn phòng'
    CHECK (availability IN ('Còn phòng', 'Hết phòng')),
  listing_status TEXT NOT NULL DEFAULT 'Chờ duyệt'
    CHECK (listing_status IN ('Chờ duyệt', 'Đang hiển thị', 'Đã ẩn', 'Đã từ chối')),
  rejection_reason TEXT,
  description TEXT NOT NULL,
  contact_name TEXT,
  contact_phone TEXT,
  contact_email TEXT,
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  FOREIGN KEY (district, ward) REFERENCES wards(district, name)
);

CREATE TABLE room_images (
  room_id TEXT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE,
  position INTEGER NOT NULL CHECK (position >= 1),
  path TEXT NOT NULL,
  alt_text TEXT,
  PRIMARY KEY (room_id, position)
);

CREATE TABLE amenities (
  code TEXT PRIMARY KEY NOT NULL,
  label TEXT NOT NULL
);

CREATE TABLE room_amenities (
  room_id TEXT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE,
  amenity_code TEXT NOT NULL REFERENCES amenities(code),
  PRIMARY KEY (room_id, amenity_code)
);

CREATE TABLE favorites (
  user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  room_id TEXT NOT NULL REFERENCES rooms(id) ON DELETE CASCADE,
  saved_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (user_id, room_id)
);

CREATE TABLE appointments (
  id TEXT PRIMARY KEY NOT NULL,
  room_id TEXT NOT NULL REFERENCES rooms(id),
  tenant_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
  visitor_name TEXT NOT NULL,
  visitor_phone TEXT NOT NULL,
  requested_date TEXT NOT NULL,
  requested_time TEXT,
  proposed_date TEXT,
  proposed_time TEXT,
  status TEXT NOT NULL DEFAULT 'Chờ xác nhận'
    CHECK (status IN ('Chờ xác nhận', 'Chờ khách phản hồi', 'Đã xác nhận',
                      'Đã từ chối', 'Đã hoàn tất')),
  created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE reports (
  id INTEGER PRIMARY KEY,
  room_id TEXT NOT NULL REFERENCES rooms(id),
  reporter_id INTEGER REFERENCES users(id) ON DELETE SET NULL,
  reason TEXT NOT NULL,
  description TEXT CHECK (length(description) <= 500),
  status TEXT NOT NULL DEFAULT 'Chờ xử lý'
    CHECK (status IN ('Chờ xử lý', 'Đã xem')),
  submitted_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX rooms_catalog_idx ON rooms(listing_status, district, ward, price_vnd);
CREATE INDEX rooms_owner_idx ON rooms(owner_id);
CREATE INDEX appointments_room_idx ON appointments(room_id, status, requested_date);
CREATE INDEX reports_status_idx ON reports(status, submitted_at);

